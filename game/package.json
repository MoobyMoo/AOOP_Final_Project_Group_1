{
  "name": "banana-bank",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "sim": "rolldown src/game/loot/sim.ts --no-codeSplitting --file /tmp/bv-sim.mjs --platform node --banner \"globalThis.location ??= { search: \\\"\\\" };\" && node /tmp/bv-sim.mjs",
    "test:save": "rolldown src/game/core/save.test.ts --file /tmp/bv-save.mjs --platform node --banner \"globalThis.location ??= { search: \\\"\\\" };\" && node /tmp/bv-save.mjs",
    "test:settlement": "rolldown src/game/loot/settlement.test.ts --no-codeSplitting --file /tmp/bv-settlement.mjs --platform node --banner \"globalThis.location ??= { search: \\\"\\\" };\" && node /tmp/bv-settlement.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "n8ao": "^2.0.2",
    "postprocessing": "^6.39.6",
    "three": "^0.187.0",
    "three-mesh-bvh": "^0.9.18"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
